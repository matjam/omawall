{
  "schemaVersion": 1,
  "id": "matjam.omawall",
  "name": "omawall",
  "version": "1.1.0",
  "author": "Nathan Ollerenshaw (matjam)",
  "description": "Replaces the Omarchy background service with a folder-backed one: point it at a wallpaper directory and it deals every display its own random image, with optional auto-shuffle. Can also generate an Omarchy theme from the wallpaper on the primary display and switch to it, so the whole desktop tracks the picture behind it.",
  "license": "MIT",
  "homepage": "https://github.com/matjam/omawall",
  "repository": "https://github.com/matjam/omawall",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Background.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Wallpapers",
    "description": "Pick a wallpaper folder, shuffle a different random image onto each display, and optionally recolor Omarchy to match.",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "imageSource": "folder",
      "folder": "",
      "recursive": true,
      "pixabayQuery": "",
      "pixabayImageType": "photo",
      "pixabayOrientation": "horizontal",
      "pixabayCategory": "",
      "pixabayMinWidth": 0,
      "pixabayMinHeight": 0,
      "pixabayEditorsChoice": false,
      "pixabaySafeSearch": true,
      "pixabayOrder": "popular",
      "pixabayCacheMB": 512,
      "perDisplay": true,
      "intervalSec": 0,
      "shuffleOnWake": false,
      "autoTheme": false,
      "primaryDisplay": "",
      "themeMode": "dark"
    },
    "schema": [
      {
        "key": "imageSource",
        "type": "string",
        "label": "Wallpaper source",
        "defaultValue": "folder",
        "description": "folder or pixabay. Must not be called 'source': Omarchy's bar reserves that key for custom QML modules."
      },
      {
        "key": "folder",
        "type": "path",
        "label": "Wallpaper folder",
        "defaultValue": "",
        "description": "Leave empty to use the current theme's backgrounds."
      },
      {
        "key": "pixabayQuery",
        "type": "string",
        "label": "Pixabay search",
        "defaultValue": "",
        "description": "Search term. Empty returns Pixabay's most popular images."
      },
      {
        "key": "pixabayImageType",
        "type": "string",
        "label": "Image type",
        "defaultValue": "photo",
        "description": "all, photo or illustration."
      },
      {
        "key": "pixabayOrientation",
        "type": "string",
        "label": "Orientation",
        "defaultValue": "horizontal",
        "description": "all, horizontal or vertical."
      },
      {
        "key": "pixabayCategory",
        "type": "string",
        "label": "Category",
        "defaultValue": "",
        "description": "One of Pixabay's categories, or empty for any."
      },
      {
        "key": "pixabayMinWidth",
        "type": "integer",
        "label": "Minimum width",
        "min": 0,
        "max": 7680,
        "step": 320,
        "defaultValue": 0,
        "description": "0 matches your largest display."
      },
      {
        "key": "pixabayMinHeight",
        "type": "integer",
        "label": "Minimum height",
        "min": 0,
        "max": 4320,
        "step": 180,
        "defaultValue": 0,
        "description": "0 matches your largest display."
      },
      {
        "key": "pixabayEditorsChoice",
        "type": "boolean",
        "label": "Editor's Choice only",
        "defaultValue": false
      },
      {
        "key": "pixabaySafeSearch",
        "type": "boolean",
        "label": "Safe search",
        "defaultValue": true
      },
      {
        "key": "pixabayOrder",
        "type": "string",
        "label": "Order",
        "defaultValue": "popular",
        "description": "popular or latest."
      },
      {
        "key": "pixabayCacheMB",
        "type": "integer",
        "label": "Image cache budget (MB)",
        "min": 64,
        "max": 8192,
        "step": 64,
        "defaultValue": 512,
        "description": "Least recently used images are evicted above this."
      },
      {
        "key": "recursive",
        "type": "boolean",
        "label": "Search subfolders",
        "defaultValue": true
      },
      {
        "key": "perDisplay",
        "type": "boolean",
        "label": "Different image per display",
        "defaultValue": true
      },
      {
        "key": "intervalSec",
        "type": "integer",
        "label": "Auto-shuffle interval (seconds)",
        "min": 0,
        "max": 86400,
        "step": 60,
        "defaultValue": 0
      },
      {
        "key": "shuffleOnWake",
        "type": "boolean",
        "label": "Shuffle on unlock or wake",
        "defaultValue": false,
        "description": "Change wallpaper when you return to the session rather than on a timer. Pairs well with theme generation, whose apply step briefly stalls input."
      },
      {
        "key": "autoTheme",
        "type": "boolean",
        "label": "Generate theme from wallpaper",
        "defaultValue": false,
        "description": "Build an 'omawall' Omarchy theme from the primary display's wallpaper and switch to it. Requires matugen."
      },
      {
        "key": "primaryDisplay",
        "type": "string",
        "label": "Primary display",
        "defaultValue": "",
        "description": "Output name whose wallpaper drives the theme. Empty uses the first connected display."
      },
      {
        "key": "themeMode",
        "type": "string",
        "label": "Theme mode",
        "defaultValue": "dark",
        "description": "dark or light."
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.background"
  }
}
